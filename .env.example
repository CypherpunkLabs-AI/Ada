# Public dummy settings for boot/attestation checks. Replace before serving users.
# These values provide no working database, authentication, queue or inference service.
ADA_BIND_ADDRESS=0.0.0.0:8443
ADA_TLS_DOMAIN=api.cypherpunklabs.io
ADA_ACME_ENVIRONMENT=production
ADA_TDX_REPORT_DIR=/run/ada/tdx-report
ADA_ATTESTATION_DIR=/run/ada/attestation
AUTH_ISSUER=https://auth.invalid
AUTH_AUTHORIZED_PARTIES=https://app.invalid
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=public-dummy-not-a-credential
NEARAI_TIMEOUT_SECONDS=600
ADA_KEYSET_TTL_SECONDS=2592000
ADA_RECEIPT_TTL_SECONDS=3600
ADA_SOURCE_REPOSITORY=https://github.com/CypherpunkLabs-AI/Ada-gateway-test
ADA_SOURCE_COMMIT=0000000000000000000000000000000000000000
DATABASE_URL=postgres://dummy:dummy@127.0.0.1:1/ada?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=2
# Credential onboarding creates a Stripe customer when none exists.
STRIPE_API_URL=https://api.stripe.com/
# STRIPE_SECRET_KEY=<server-side Stripe secret key>
CACHE_NAMESPACE_KEY=public-dummy-cache-namespace-not-a-secret
INFERENCE_SYSTEM_PROMPT=You are Ada.
INFERENCE_MAX_CONCURRENCY=8
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_USAGE_QUEUE_ID=00000000000000000000000000000000
CLOUDFLARE_QUEUES_API_TOKEN=public-dummy-not-a-credential
USAGE_HMAC_SECRET=public-dummy-usage-hmac-key-not-a-secret
RUST_LOG=ada_proxy=info
# Optional encrypted attachment storage; configure all four R2 settings together.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=<bucket>
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>
# R2_PRESIGN_TTL_SECONDS=900
# MAX_ATTACHMENT_BYTES=20971520
# Optional document conversion must stay in the same measured guest over Unix sockets.
# DOCUMENT_ROUTER_SOCKET=/run/ada/documents/router.sock
# DOCUMENT_VISION_SOCKET=/run/ada/documents/vision.sock
# DOCUMENT_VISION_MODEL=<approved model>
# DOCUMENT_VISION_BROKER_TOKEN=<shared random secret of at least 32 bytes>
